Options -Indexes
LimitRequestBody 8388608
RedirectMatch 404 "(^|/)\."
<FilesMatch "^\.">
Require all denied
</FilesMatch>
<FilesMatch "^(config.*\.php|schema\.sql|README\.md|create-admin\.php|.*\.log)$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
